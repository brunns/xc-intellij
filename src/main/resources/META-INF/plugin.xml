<!-- Plugin Configuration File. Read more: https://plugins.jetbrains.com/docs/intellij/plugin-configuration-file.html -->
<idea-plugin>
    <id>com.github.brunns.xcintellij</id>
    <name>XC Tasks</name>
    <vendor>brunns</vendor>
    <description><![CDATA[
        <p>IntelliJ plugin to allow running xc tasks</p>
    ]]></description>

    <depends>com.intellij.modules.platform</depends>

    <resource-bundle>messages.XcTaskBundle</resource-bundle>

    <extensions defaultExtensionNs="com.intellij">
        <configurationType implementation="ing.brunn.xcintellij.run.XcConfigurationType"/>

        <applicationConfigurable
                parentId="tools"
                instance="ing.brunn.xcintellij.services.XcSettingsConfigurable"
                id="ing.brunn.xcintellij.services.XcSettingsConfigurable"
                displayName="xc Task Runner"/>

        <toolWindow id="xc Tasks"
                    anchor="right"
                    icon="AllIcons.Actions.Execute"
                    factoryClass="ing.brunn.xcintellij.toolWindow.XcToolWindowFactory"/>
    </extensions>
</idea-plugin>
